    def calculate_signals(self, symbol, timeframe, ohlc_data):
        """
        ⭐ lele() 함수 100개 인스턴스 실행 (Pine Script와 동일)
        ⚡ 슬라이딩 윈도우(rolling) + numpy 벡터 연산 최적화 (결과 동일)
        """
        if ohlc_data.empty or len(ohlc_data) < 5:
            return 0

        closes = ohlc_data['Close'].values.astype(float)
        opens = ohlc_data['Open'].values.astype(float)
        highs = ohlc_data['High'].values.astype(float)
        lows = ohlc_data['Low'].values.astype(float)
        n_bars = len(ohlc_data)

        qual = self.qual_value

        # ⚡ 1단계: 100개 윈도우 길이별 rolling 최고가/최저가 사전 계산
        hs = pd.Series(highs)
        ls = pd.Series(lows)
        roll_max = np.empty((100, n_bars), dtype=np.float64)
        roll_min = np.empty((100, n_bars), dtype=np.float64)
        for i, len_ in enumerate(self.value_array):
            roll_max[i] = hs.rolling(len_, min_periods=1).max().values
            roll_min[i] = ls.rolling(len_, min_periods=1).min().values

        bindex = np.zeros(100, dtype=np.float64)
        sindex = np.zeros(100, dtype=np.float64)

        total_signals = 0

        # ⚡ 2단계: 모든 바를 순서대로 처리 (인스턴스 100개는 벡터 연산)
        for bar_idx in range(4, n_bars):
            close_curr = closes[bar_idx]
            close_prev4 = closes[bar_idx - 4]
            open_curr = opens[bar_idx]
            high_curr = highs[bar_idx]
            low_curr = lows[bar_idx]

            if close_curr > close_prev4:
                bindex += 1
            if close_curr < close_prev4:
                sindex += 1

            bar_sum = 0

            if close_curr < open_curr:
                mask = (bindex > qual) & (high_curr >= roll_max[:, bar_idx])
                if mask.any():
                    bindex[mask] = 0
                    bar_sum -= int(mask.sum())
            elif close_curr > open_curr:
                mask = (sindex > qual) & (low_curr <= roll_min[:, bar_idx])
                if mask.any():
                    sindex[mask] = 0
                    bar_sum += int(mask.sum())

            total_signals = bar_sum

        logger.debug(f"📊 {symbol} {timeframe}: PRZ 신호값 = {total_signals}")
        return total_signals

    def calculate_mfi(self, ohlc_data, period=14):
        """Money Flow Index 계산 (⚡ 벡터화)"""
        if ohlc_data.empty or len(ohlc_data) < period:
            return None

        highs = ohlc_data['High'].values.astype(float)
        lows = ohlc_data['Low'].values.astype(float)
        closes = ohlc_data['Close'].values.astype(float)
        vols = ohlc_data['Volume'].values.astype(float)
        n = len(closes)

        tp = (highs + lows + closes) / 3
        rmf = tp * vols

        pos_flow = np.zeros(n)
        neg_flow = np.zeros(n)
        up = tp[1:] > tp[:-1]
        pos_flow[1:][up] = rmf[1:][up]
        neg_flow[1:][~up] = rmf[1:][~up]

        pos_sum = pos_flow[-period:].sum()
        neg_sum = neg_flow[-period:].sum()

        if pos_sum + neg_sum == 0:
            return 50.0

        mfi = 100 - (100 / (1 + pos_sum / neg_sum))
        return mfi

