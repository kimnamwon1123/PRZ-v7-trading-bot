def send_telegram(symbol, timeframe, signal_type, current_price, total_signals,
                  qual_value, mfi_val, is_korean=False, is_crypto=False, is_futures=False):
    """Telegram 신호 알람 발송 (통합 시그널)"""
    if not requests:
        logger.warning("requests 모듈 없음. Telegram 발송 불가.")
        return False

    # ⭐⭐ 시그널 차단 종목은 텔레그램 알람 제외 (Pine: symBlocked)
    if is_symbol_blocked(symbol):
        logger.info(f"🚫 차단 종목 텔레그램 제외: {symbol} {timeframe} {signal_type}")
        return False

    try:
        if is_crypto:
            market = "[암호화폐]"
        elif is_futures:
            market = "[해외선물]"
        elif is_korean:
            market = "[한국주식]"
        else:
            market = "[미국주식]"

        if signal_type == 'LONG':
            signal_str = "🔵 PRZ 롱(매수) 시그널"
        else:
            signal_str = "🔴 PRZ 숏(매도) 시그널"

        tf_kr = {'1h': '1시간봉', '4h': '4시간봉', '8h': '8시간봉', '1d': '일봉'}
        timeframe_str = tf_kr.get(timeframe, timeframe)
        current_date = datetime.now().strftime('%Y-%m-%d')

        if is_crypto:
            price_str = f"${current_price:,.2f}"
            name = CRYPTO_NAMES.get(symbol, symbol)
            ticker = symbol.replace('-USD', '')
            symbol_display = f"<code>{name}</code>(<code>{ticker}</code>)"
        elif is_futures:
            price_str = f"${current_price:,.2f}"
            name = FUTURES_SYMBOLS.get(symbol, symbol)
            tv_symbol = symbol.replace('=F', '') + '1!'
            symbol_display = f"<code>{name}</code>(<code>{tv_symbol}</code>)"
        elif is_korean:
            price_str = f"{current_price:,.0f}₩"
            name = get_korean_name(symbol)
            symbol_display = f"<code>{name}</code>(<code>{symbol}</code>)"
        else:
            price_str = f"${current_price:.2f}"
            kr_name = US_STOCK_NAMES.get(symbol)
            if kr_name:
                symbol_display = f"<code>{symbol}</code>({kr_name})"
            else:
                symbol_display = f"<code>{symbol}</code>"

        message = f"""{market} {signal_str}
종목: {symbol_display}
타임프레임: {timeframe_str}
가격: {price_str}
날짜: {current_date}"""

        url = f"https://api.telegram.org/bot{TELEGRAM_TOKEN}/sendMessage"
        payload = {"chat_id": TELEGRAM_CHAT_ID, "text": message, "parse_mode": "HTML"}
        response = requests.post(url, json=payload, timeout=5)
        if response.status_code == 200:
            logger.info(f"✅ Telegram 발송: {symbol} {timeframe} {signal_type}")
            return True
        else:
            logger.warning(f"❌ Telegram 발송 실패: {response.status_code}")
            return False
    except Exception as e:
        logger.error(f"Telegram 에러: {e}")
        return False

