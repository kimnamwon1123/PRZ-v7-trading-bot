    def detect_signal(self, symbol, timeframe, ohlc_data, is_korean=False, is_crypto=False):
        """
        ⭐ Pine Script "WONEY PRZ STELLAR"와 100% 동일한 통합 신호 감지

        반환: (signal_type, prz_total, mfi_val, threshold, base_val, star_total, star_th, source)
        """
        if ohlc_data.empty or len(ohlc_data) < 5:
            return 'NEUTRAL', 0, None, 0, 0, 0, 0, None

        # ⭐⭐ 시그널 차단 종목 (Pine: symBlocked) → 계산 자체를 생략 (CPU 절약)
        if is_symbol_blocked(symbol):
            logger.debug(f"🚫 {symbol}: 시그널 차단 종목 (blockSymList)")
            return 'NEUTRAL', 0, None, 0, 0, 0, 0, None

        asset_type = self._detect_asset_type(symbol)
        tf_idx = self._get_tf_index(timeframe)

        mfi_len, mfi_ob, mfi_os = self._get_mfi_params(tf_idx, asset_type)

        # ═══════════ PART 1. PRZ v7 시그널 ═══════════
        base_val = self._get_base_value(tf_idx, asset_type)
        mult = self._get_mult_value(tf_idx, asset_type)

        long_value = self._get_long_value(timeframe, base_val, mult)
        short_value = -base_val * mult

        if is_crypto:
            # ⭐ Pine: przAllowedMarket = not isCryptocurrency → 암호화폐는 PRZ 미발동
            prz_total = 0
            mfi_val = None
            prz_short = False
            prz_long = False
        else:
            prz_total = self.calculate_signals(symbol, timeframe, ohlc_data)
            mfi_val = self.calculate_mfi(ohlc_data, period=mfi_len) if self.use_mfi else None

            if self.use_mfi and mfi_val is not None:
                prz_short = self.show_prz and (prz_total <= short_value) and (mfi_val >= mfi_ob)
                prz_long = self.show_prz and (prz_total >= long_value) and (mfi_val <= mfi_os)
            else:
                prz_short = self.show_prz and (prz_total <= short_value)
                prz_long = self.show_prz and (prz_total >= long_value)

        # ⭐ Pine: PRZ 단일 시그널 통합 (동시 발생 시 롱 우선)
        if prz_short and prz_long:
            one_long, one_short = True, False
        else:
            one_long, one_short = prz_long, prz_short

        # ═══════════ PART 2. 별 시그널 ═══════════
        star_asset = 'btc' if is_crypto else asset_type
        star_th = self._get_star_threshold(timeframe, star_asset)
        star_total = self.calculate_star(symbol, timeframe, ohlc_data)

        star_long = self.show_star and (star_total >= star_th)
        star_short = self.show_star and (star_total <= -star_th)

        # ═══════════ ⭐⭐⭐ PART 2.5. 정확도 필터 ═══════════
        any_candidate = one_long or one_short or star_long or star_short

        if any_candidate:
            # 거래량 필터 (롱/숏, 티어 배수 반영)
            vol_ok, vol_ok_s = self._check_volume_filter(symbol, ohlc_data)

            # ⭐⭐⭐ 주봉 슈퍼트렌드 필터
            st_ok_l, st_ok_s = self._check_supertrend(symbol, ohlc_data)

            # 상위TF(주봉 EMA30) 추세 필터
            htf_ok = self._check_htf_trend(ohlc_data)

            # MFI 과매도 강화 필터 (Pine: mfi <= mfiOS - mfiExtra)
            if USE_UPDATE and USE_MFI_STRICT:
                _mfi = mfi_val if mfi_val is not None else self.calculate_mfi(ohlc_data, period=mfi_len)
                mfi_ok = (_mfi is not None) and (_mfi <= (mfi_os - MFI_EXTRA))
            else:
                mfi_ok = True

            # 양봉 마감 필터 (Pine: useBullClose)
            last_bar = ohlc_data.iloc[-1]
            bull_ok = (not (USE_UPDATE and USE_BULL_CLOSE)) or bool(last_bar['Close'] > last_bar['Open'])
        else:
            vol_ok = vol_ok_s = htf_ok = mfi_ok = bull_ok = True
            st_ok_l = st_ok_s = True

        # ═══════════ PART 3. 두 엔진 통합 ═══════════
        if USE_UPDATE and USE_BOTH_ENGINES:
            raw_long_base = one_long and star_long
        else:
            raw_long_base = one_long or star_long

        raw_long = raw_long_base and htf_ok and mfi_ok and vol_ok and bull_ok and st_ok_l
        raw_short = (one_short or star_short) and vol_ok_s and st_ok_s

        # ⭐ 같은 봉에서 롱/숏 동시 발생 시 롱 우선 + 숏 마스터 스위치
        final_long = raw_long
        final_short = raw_short and (not raw_long) and SHOW_SHORT

        if final_long:
            src = []
            if one_long:
                src.append('PRZ')
            if star_long:
                src.append('STAR')
            source = '+'.join(src)
            return 'LONG', prz_total, mfi_val, long_value, base_val, star_total, star_th, source
        elif final_short:
            src = []
            if one_short:
                src.append('PRZ')
            if star_short:
                src.append('STAR')
            source = '+'.join(src)
            return 'SHORT', prz_total, mfi_val, short_value, base_val, star_total, star_th, source
        else:
            if any_candidate:
                logger.debug(
