    def _get_star_threshold(self, timeframe, asset_type='stock'):
        """⭐ Pine Script 타임프레임별 별 임계값 (Num_Value_*)"""
        if asset_type in ('btc', 'eth'):
            tf_map = {'5m': 6, '15m': 5, '30m': 5, '1h': 5, '2h': 4,
                      '4h': 4, '6h': 3, '8h': 3, '12h': 2}
            base = tf_map.get(timeframe, 2)   # Num_Value_remain = 2
        else:
            tf_map = {'5m': 6, '15m': 6, '30m': 6, '1h': 6, '2h': 5,
                      '4h': 5, '6h': 4, '8h': 4, '12h': 1}
            base = tf_map.get(timeframe, 3)   # Num_Value_remain = 3 (일봉 포함)

        return max(1, base + self.star_tune_offset)

    def calculate_star(self, symbol, timeframe, ohlc_data):
        """⭐ 별 시그널 계산 (Pine Script 배열 최적화 방식과 100% 동일)"""
        if ohlc_data.empty or len(ohlc_data) < 5:
            return 0

        closes = ohlc_data['Close'].values.astype(float)
        opens = ohlc_data['Open'].values.astype(float)
        highs = ohlc_data['High'].values.astype(float)
        lows = ohlc_data['Low'].values.astype(float)
        n_bars = len(ohlc_data)

        quals = self.STAR_QUALS
        n_quals = len(quals)

        resetB = [0] * n_quals
        resetS = [0] * n_quals

        globalB = 0
        globalS = 0

        hVals, hIdx = [], []
        lVals, lIdx = [], []

        INF = 2147483647
        star_total = 0

        for bar_idx in range(n_bars):
            c = closes[bar_idx]
            o = opens[bar_idx]
            h = highs[bar_idx]
            l = lows[bar_idx]

            if bar_idx >= 4:
                if c > closes[bar_idx - 4]:
                    globalB += 1
                if c < closes[bar_idx - 4]:
                    globalS += 1

            while hVals and hVals[-1] <= h:
                hVals.pop()
                hIdx.pop()
            distHigh = INF if not hIdx else bar_idx - hIdx[-1]
            hVals.append(h)
            hIdx.append(bar_idx)

            while lVals and lVals[-1] >= l:
                lVals.pop()
                lIdx.pop()
            distLow = INF if not lIdx else bar_idx - lIdx[-1]
            lVals.append(l)
            lIdx.append(bar_idx)

            star_total = 0
            is_down = c < o
            is_up = c > o

            if is_down:
                for i in range(n_quals):
                    q = quals[i]
                    if q > distHigh or q >= globalB:
                        break
                    if globalB - resetB[i] > q:
                        resetB[i] = globalB
                        star_total -= 1

            if is_up:
                for i in range(n_quals):
                    q = quals[i]
                    if q > distLow or q >= globalS:
                        break
                    if globalS - resetS[i] > q:
                        resetS[i] = globalS
                        star_total += 1

        logger.debug(f"📊 {symbol} {timeframe}: 별 신호값 = {star_total}")
        return star_total

