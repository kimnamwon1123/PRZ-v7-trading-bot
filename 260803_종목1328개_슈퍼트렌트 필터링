# ⭐⭐⭐ 심볼 리스트 매칭 헬퍼 (Pine f_inSymList와 동일)
# ============================================================================
def _sym_candidates(symbol):
    """
    심볼 → 매칭 후보 집합 생성
    - 미국주식/한국주식: 심볼 그대로 (대문자)
    - 암호화폐: BTC-USD → BTC, BTCUSD, BTCUSDT, BTCUSDT.P (트레이딩뷰 표기 대응)
    - 해외선물: GC=F → GC, GC1! (트레이딩뷰 표기 대응)
    """
    s = str(symbol).upper().strip()
    cands = {s}
    if s.endswith('-USD'):
        base = s[:-4]
        cands.update({base, base + 'USD', base + 'USDT', base + 'USDT.P', base + 'KRW'})
    if s.endswith('=F'):
        base = s[:-2]
        cands.update({base, base + '1!'})
    return cands

def in_sym_list(symbol, sym_list_str):
    """⭐ Pine f_inSymList()와 동일: 쉼표 리스트에 심볼 포함 여부 (공백 제거, 대문자 비교)"""
    if not sym_list_str:
        return False
    cleaned = sym_list_str.replace(' ', '').upper()
    entries = {e for e in cleaned.split(',') if e}
    if not entries:
        return False
    return not entries.isdisjoint(_sym_candidates(symbol))

def is_symbol_blocked(symbol):
    """⭐⭐ 시그널 차단 종목 여부 (Pine: symBlocked) → 텔레그램 알람도 제외"""
    return in_sym_list(symbol, BLOCK_SYM_LIST)

def get_vol_filter_params(symbol):
    """
    ⭐⭐ Pine PART 2.5 거래량 티어 로직과 100% 동일

    Pine 원문 대응:
      volMultActive = in16 ? vol16Val : in14 ? vol14Val : volMult
      volSymApplyF  = hasTier or not inExclude
      volMultShort  = inAnyShort ? max(volMultActive, shortMultPick) : volMultActive
      volSymApplyF_S= inAnyShort or volSymApplyF

    반환: (롱배수, 롱적용여부, 숏배수, 숏적용여부)
    """
    in_exclude = in_sym_list(symbol, VOL_SYM_LIST)
    in14 = in_sym_list(symbol, VOL14_LIST)
    in16 = in_sym_list(symbol, VOL16_LIST)

    # 우선순위: B그룹 > A그룹 > 기본
    mult_active = VOL16_VAL if in16 else (VOL14_VAL if in14 else VOL_MULT)
    has_tier = in14 or in16
    apply_long = has_tier or (not in_exclude)

    in_s1 = in_sym_list(symbol, SHORT_VOL_LIST)
    in_s2 = in_sym_list(symbol, SHORT_VOL_LIST2)
    in_any_short = in_s1 or in_s2
    short_pick = SHORT_VOL_MULT2 if in_s2 else SHORT_VOL_MULT
    mult_short = max(mult_active, short_pick) if in_any_short else mult_active
    apply_short = in_any_short or apply_long

    return mult_active, apply_long, mult_short, apply_short

