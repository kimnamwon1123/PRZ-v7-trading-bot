# ⭐⭐⭐ 슈퍼트렌드 (Pine ta.supertrend 100% 동일 구현)
# ============================================================================
def _wilder_atr(high, low, close, period):
    """Pine ta.atr(period) = ta.rma(ta.tr(true), period) 와 동일 (Wilder 평활)"""
    n = len(close)
    tr = np.empty(n, dtype=np.float64)
    tr[0] = high[0] - low[0]
    pc = close[:-1]
    tr[1:] = np.maximum(
        high[1:] - low[1:],
        np.maximum(np.abs(high[1:] - pc), np.abs(low[1:] - pc))
    )
    atr = np.full(n, np.nan)
    if n >= period:
        atr[period - 1] = tr[:period].mean()
        for i in range(period, n):
            atr[i] = (atr[i - 1] * (period - 1) + tr[i]) / period
    return atr

def calc_supertrend(df, factor=3.0, atr_period=10):
    """
    ⭐⭐⭐ Pine ta.supertrend(factor, atrPeriod) 와 100% 동일

    반환: (supertrend 배열, direction 배열)
      direction: -1 = 상승추세 / +1 = 하락추세  (Pine 규약과 동일)
    """
    h = df['High'].values.astype(float)
    l = df['Low'].values.astype(float)
    c = df['Close'].values.astype(float)
    n = len(c)
    if n < 2:
        return None, None

    atr = _wilder_atr(h, l, c, atr_period)
    hl2 = (h + l) / 2.0
    direction = np.full(n, np.nan)
    st = np.full(n, np.nan)

    prev_upper = prev_lower = prev_st = np.nan
    for i in range(n):
        if np.isnan(atr[i]):
            continue

        upper = hl2[i] + factor * atr[i]
        lower = hl2[i] - factor * atr[i]

        # Pine: prevLowerBand = nz(lowerBand[1]) / prevUpperBand = nz(upperBand[1])
        pu = 0.0 if np.isnan(prev_upper) else prev_upper
        pl = 0.0 if np.isnan(prev_lower) else prev_lower

        if not (lower > pl or c[i - 1] < pl):
            lower = pl
        if not (upper < pu or c[i - 1] > pu):
            upper = pu

        if i == 0 or np.isnan(atr[i - 1]):
            d = 1                                   # Pine: na(atr[1]) → direction := 1
        elif prev_st == pu:
            d = -1 if c[i] > upper else 1
        else:
            d = 1 if c[i] < lower else -1

        st_val = lower if d == -1 else upper
        direction[i] = d
        st[i] = st_val
        prev_upper, prev_lower, prev_st = upper, lower, st_val

    return st, direction

