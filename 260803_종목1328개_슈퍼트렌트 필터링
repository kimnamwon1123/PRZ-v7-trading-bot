    def _check_htf_trend(self, ohlc_data):
        """
        상위TF(주봉 EMA30) 추세 필터 (Pine: useHTFTrend)
        Pine: request.security("W", ta.ema(close, 30)[1]) → 완성된 주봉 기준 (노리페인트)
        """
        if not (USE_UPDATE and USE_HTF_TREND):
            return True
        try:
            closes_w = ohlc_data['Close'].resample('W').last().dropna()
            if len(closes_w) < 2:
                return True
            closes_w = closes_w.iloc[:-1]  # 마지막(미완성 가능) 주봉 제외 → Pine [1]과 동일
            if len(closes_w) < HTF_EMA_LEN:
                return True
            ema = closes_w.ewm(span=HTF_EMA_LEN, adjust=False).mean()
            return bool(closes_w.iloc[-1] >= ema.iloc[-1])
        except Exception as e:
            logger.debug(f"HTF 추세 필터 계산 실패 (통과 처리): {e}")
            return True

    def _check_volume_filter(self, symbol, ohlc_data):
        """
        ⭐ 거래량 필터 (Pine: volCond / volCondShort, 티어 배수 반영)
        시그널 봉(마지막 확정 캔들) 기준. sma 미형성(20봉 미만) 시 Pine의 na와 동일하게 불성립.
        반환: (vol_ok_long, vol_ok_short)
        """
        mult_l, apply_l, mult_s, apply_s = get_vol_filter_params(symbol)

        need_long = USE_UPDATE and USE_VOL_FILTER and apply_l
        need_short = USE_UPDATE and USE_VOL_FILTER_S and apply_s
        if not need_long and not need_short:
            return True, True

        vols = ohlc_data['Volume'].values.astype(float)
        if len(vols) >= 20:
            sma20 = vols[-20:].mean()
            cond_l = bool(vols[-1] >= sma20 * mult_l)
            cond_s = bool(vols[-1] >= sma20 * mult_s)
        else:
            cond_l = cond_s = False   # Pine: sma가 na → 조건 불성립

        vol_ok_long = (not need_long) or cond_l
        vol_ok_short = (not need_short) or cond_s
        return vol_ok_long, vol_ok_short

    def _check_supertrend(self, symbol, ohlc_data):
        """
        ⭐⭐⭐ 주봉 슈퍼트렌드 필터 (Pine: stOK_L / stOK_S)
        - 완성된 직전 주봉 기준 (stNoRepaint=true → 리페인트 없음)
        - 상승추세(dir < 0) → 롱 차단 / 하락추세 → 숏 차단
        - ST_SYM_LIST 종목은 필터 미적용 (Pine: inSTList → stActive=false)
        반환: (st_ok_long, st_ok_short)
        """
        if not (USE_UPDATE and USE_ST_FILTER):
            return True, True
        if in_sym_list(symbol, ST_SYM_LIST):   # 제외 리스트
            return True, True

        up_trend = False
        try:
            agg = {'Open': 'first', 'High': 'max', 'Low': 'min',
                   'Close': 'last', 'Volume': 'sum'}
            wk = ohlc_data.resample('W').agg(agg).dropna()
            if len(wk) >= 2:
                wk = wk.iloc[:-1]   # 진행중 주봉 제외 → Pine [1]과 동일
                _st, _dir = calc_supertrend(wk, ST_FACTOR, ST_ATR_PERIOD)
                if _dir is not None and not np.isnan(_dir[-1]):
                    up_trend = bool(_dir[-1] < 0)
        except Exception as e:
            logger.debug(f"슈퍼트렌드 계산 실패 ({symbol}): {e}")

        st_ok_l = (not ST_APPLY_LONG) or (not up_trend)
        st_ok_s = (not ST_APPLY_SHORT) or up_trend
        return st_ok_l, st_ok_s

