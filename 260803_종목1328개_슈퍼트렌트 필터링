def get_tf_minutes(interval):
    """타임프레임을 분 단위로 변환"""
    tf_map = {
        '1m': 1, '3m': 3, '5m': 5, '15m': 15, '30m': 30,
        '1h': 60, '2h': 120, '3h': 180, '4h': 240, '8h': 480,
        '1d': 1440
    }
    return tf_map.get(interval, 60)

def is_candle_completed(last_candle_time, interval):
    """마지막 캔들이 완성되었는지 확인"""
    if last_candle_time is None:
        return False

    try:
        if hasattr(last_candle_time, 'tzinfo') and last_candle_time.tzinfo is not None:
            last_candle_utc = last_candle_time.astimezone(pytz.UTC)
        else:
            last_candle_utc = pytz.UTC.localize(last_candle_time)

        now_utc = datetime.now(pytz.UTC)
        tf_minutes = get_tf_minutes(interval)
        candle_end_time = last_candle_utc + timedelta(minutes=tf_minutes)
        is_completed = now_utc >= candle_end_time

        logger.debug(
            f"캔들 상태: {last_candle_utc.strftime('%H:%M')} → "
            f"{candle_end_time.strftime('%H:%M')} (현재: {now_utc.strftime('%H:%M')}) "
            f"→ {'✅' if is_completed else '⏳'}"
        )
        return is_completed
    except Exception as e:
        logger.error(f"캔들 완성 판정 에러: {e}")
        return False

def _resample_8h(df):
    """1시간봉 → 8시간봉 리샘플 (UTC 00:00/08:00/16:00 경계, 트레이딩뷰와 동일)"""
    if df.index.tz is None:
        df.index = df.index.tz_localize('UTC')
    else:
        df.index = df.index.tz_convert('UTC')

    agg = {'Open': 'first', 'High': 'max', 'Low': 'min', 'Close': 'last', 'Volume': 'sum'}
    try:
        out = df.resample('8h', origin='epoch').agg(agg)
    except (ValueError, TypeError):
        out = df.resample('8H', origin='epoch').agg(agg)
    return out.dropna()

def _yf_download(ticker, fetch_interval, lookback_days, label=''):
    """yfinance 단일 다운로드 (1h는 기간을 절반씩 줄여 최대 3회 재시도)"""
    end_date = datetime.now()
    df = pd.DataFrame()
    attempt_days = lookback_days
    for attempt in range(3):
        try:
            df = yf.download(
                ticker,
                start=end_date - timedelta(days=attempt_days),
                end=end_date,
                interval=fetch_interval,
                progress=False,
                timeout=30
            )
        except Exception:
            df = pd.DataFrame()

        if df is not None and not df.empty:
            break

        if fetch_interval != '1h':
            break

        attempt_days = attempt_days // 2
        logger.debug(f"⚠️ {ticker} {label}: 1h 다운로드 실패, {attempt_days}일로 재시도...")

    return df if df is not None else pd.DataFrame()

def get_ohlc_data(symbol, interval, lookback_days=60):
    """
    OHLC 데이터 수집 (8h는 1h 수집 후 리샘플)

    ⭐⭐⭐ 한국 종목은 코스피(.KS) / 코스닥(.KQ)을 자동 판별한다.
        기존에는 .KS로 고정해 코스닥 종목이 11봉짜리 엉터리 데이터를 받아
        시그널이 영구히 발동하지 않는 버그가 있었다.
        한 번 확인된 접미사는 캐시에 저장해 이후 스캔에서는 1회만 다운로드한다.
    """
    if not yf:
        logger.error("❌ yfinance 없음")
        return pd.DataFrame()

    try:
        fetch_interval = '1h' if interval == '8h' else interval
        is_kr = len(symbol) == 6 and symbol.isdigit()

        if is_kr:
            cached = _KR_SUFFIX_CACHE.get(symbol)
            candidates = [f"{symbol}{cached}"] if cached else [f"{symbol}.KS", f"{symbol}.KQ"]
        else:
            candidates = [symbol]

        df = pd.DataFrame()
        picked = None
        for tk in candidates:
            d = _yf_download(tk, fetch_interval, lookback_days, interval)
            if len(d) > len(df):
                df, picked = d, tk
            if len(df) >= KR_MIN_VALID_BARS:
                break   # 충분한 히스토리 확보 → 나머지 후보 조회 생략

        if is_kr and picked is not None and not df.empty:
            suffix = picked[-3:]
            if _KR_SUFFIX_CACHE.get(symbol) != suffix:
                _KR_SUFFIX_CACHE[symbol] = suffix
                if len(candidates) > 1:
                    logger.debug(f"🔎 {symbol}: 시장 접미사 {suffix} 확정 ({len(df)}개 바)")

        if df is None or df.empty:
            logger.debug(f"데이터 없음: {symbol} {interval}")
            return pd.DataFrame()

        if isinstance(df.columns, pd.MultiIndex):
            df.columns = df.columns.droplevel(1)

        df.columns = df.columns.str.lower()

        required_cols = ['open', 'high', 'low', 'close', 'volume']
        if not all(col in df.columns for col in required_cols):
            logger.error(f"필수 컬럼 부족: {symbol} {interval}")
            return pd.DataFrame()

        df = df[required_cols].copy()
        df.columns = ['Open', 'High', 'Low', 'Close', 'Volume']

        if df.isnull().any().any():
            df.dropna(inplace=True)

        if interval == '8h':
            df = _resample_8h(df)

        if df.empty or len(df) < 5:
            logger.debug(f"데이터 부족: {symbol} {interval}")
            return pd.DataFrame()

        # ⭐ Pine Script barstate.isconfirmed 방식
        last_candle_time = df.index[-1]

        if is_candle_completed(last_candle_time, interval):
            logger.debug(f"✅ {symbol} {interval}: 현재 캔들 완성, 포함 ({len(df)}개 바)")
            return df
        else:
            logger.debug(f"⏳ {symbol} {interval}: 현재 캔들 미완성, 제외 ({len(df)-1}개 바)")
            df_prev = df.iloc[:-1]
            if len(df_prev) < 5:
                logger.debug(f"분석 가능한 캔들 부족: {symbol} {interval}")
                return pd.DataFrame()
            return df_prev

    except Exception as e:
        logger.error(f"❌ 데이터 수집 실패 ({symbol}, {interval}): {e}")
        return pd.DataFrame()

def get_crypto_ohlc_data(symbol, tf):
    """암호화폐/해외선물 OHLC 수집 (1d 직접, 8h는 1h 리샘플)"""
    if not yf:
        logger.error("❌ yfinance 없음")
        return pd.DataFrame()

    try:
        end_date = datetime.now()

        if tf == '1d':
            start_date = end_date - timedelta(days=LOOKBACK_1D)
            fetch_interval = '1d'
        else:
            start_date = end_date - timedelta(days=CRYPTO_8H_LOOKBACK)
            fetch_interval = '1h'

        df = pd.DataFrame()
        attempt_days = (end_date - start_date).days
        for attempt in range(3):
            try:
                df = yf.download(
                    symbol,
                    start=end_date - timedelta(days=attempt_days),
                    end=end_date,
                    interval=fetch_interval,
                    progress=False,
                    timeout=30
                )
            except Exception:
                df = pd.DataFrame()

            if df is not None and not df.empty:
                break

            if fetch_interval != '1h':
                break

            attempt_days = attempt_days // 2
            logger.debug(f"⚠️ {symbol} {tf}: 1h 다운로드 실패, {attempt_days}일로 재시도...")

        if df is None or df.empty:
            logger.debug(f"데이터 없음: {symbol} {tf}")
            return pd.DataFrame()

        if isinstance(df.columns, pd.MultiIndex):
            df.columns = df.columns.droplevel(1)

        df.columns = df.columns.str.lower()

        required_cols = ['open', 'high', 'low', 'close', 'volume']
        if not all(col in df.columns for col in required_cols):
            logger.error(f"필수 컬럼 부족: {symbol} {tf}")
            return pd.DataFrame()

        df = df[required_cols].copy()
        df.columns = ['Open', 'High', 'Low', 'Close', 'Volume']
        df.dropna(inplace=True)

        if df.empty:
            return pd.DataFrame()

        if tf == '8h':
            df = _resample_8h(df)

        if len(df) < 5:
            logger.debug(f"데이터 부족: {symbol} {tf}")
            return pd.DataFrame()

        last_candle_time = df.index[-1]
        if is_candle_completed(last_candle_time, tf):
            logger.debug(f"✅ {symbol} {tf}: 현재 캔들 완성, 포함 ({len(df)}개 바)")
            return df
        else:
            logger.debug(f"⏳ {symbol} {tf}: 현재 캔들 미완성, 제외 ({len(df)-1}개 바)")
            df_prev = df.iloc[:-1]
            if len(df_prev) < 5:
                return pd.DataFrame()
            return df_prev

    except Exception as e:
        logger.error(f"❌ 데이터 수집 실패 ({symbol}, {tf}): {e}")
        return pd.DataFrame()

