  ※ 되돌리려면:  cp prz_v7_star_scanner.py.bak prz_v7_star_scanner.py

작성: 지금까지
"""

import os
import shutil
import sys

TARGET = "prz_v7_star_scanner.py"
BACKUP = TARGET + ".bak"

# ---------------------------------------------------------------------------
# ④ 스캔 스케줄러 코드 (main() 앞에 삽입됨)
# ---------------------------------------------------------------------------
SCHEDULER_CODE = '''# ============================================================================
