#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
prz_v7_star_scanner.py 패치 스크립트 (v3)
=========================================

적용 내용 (4가지)
  1. 숏 시그널 표기  : "🔴 PRZ 숏(매도) 시그널"  →  "🎯 PRZ 숏(익절) 추천자리"
  2. 암호화폐 표기   : "[코인]"                  →  "[암호화폐]"
  3. 가격 기준 변경  : 종가(Close)               →  캔들 몸통 중간 (Open+Close)/2
                       (scan_symbol / scan_crypto_symbol / scan_futures_symbol 3곳)
  4. 스캔 주기 변경  : 12시간(43200초)           →  11시간(39600초)
                       12시간은 하루의 약수라 매일 같은 시간대에 알람이 고정되지만,
                       11시간은 하루(24h)와 나누어떨어지지 않아 발송 시각이
                       매 회차 1시간씩 자연스럽게 앞당겨짐 → 패턴이 드러나지 않음

사용법 (PythonAnywhere Bash 콘솔)
  cd ~
  python3 patch_scanner.py

  ※ 원본은 prz_v7_star_scanner.py.bak 으로 자동 백업됩니다.
  ※ 되돌리려면:  cp prz_v7_star_scanner.py.bak prz_v7_star_scanner.py

작성: 지금까지
"""

import os
import shutil
import sys

TARGET = "prz_v7_star_scanner.py"
BACKUP = TARGET + ".bak"

# ---------------------------------------------------------------------------
# 치환 규칙: (설명, 찾을 문자열, 바꿀 문자열, 예상 등장 횟수)
# ---------------------------------------------------------------------------
RULES = [
    (
        "① 숏 시그널 → 익절 추천자리",
        'signal_str = "🔴 PRZ 숏(매도) 시그널"',
        'signal_str = "🎯 PRZ 숏(익절) 추천자리"',
        1,
    ),
    (
        "② [코인] → [암호화폐]",
        'market = "[코인]"',
        'market = "[암호화폐]"',
        1,
    ),
    (
        "③ 가격 기준: 종가 → 캔들 몸통 중간",
        "current_price = ohlc_slice.iloc[-1]['Close']",
        "current_price = (ohlc_slice.iloc[-1]['Open'] + ohlc_slice.iloc[-1]['Close']) / 2",
        3,
    ),
    (
        "④ 스캔 주기: 12시간 → 11시간",
        "SCAN_INTERVAL = 43200  # ⭐ 12시간 (43200초) — 하루 2번, 주식 일봉 위주 + 최근 2봉 판정으로 누락 방지",
        "SCAN_INTERVAL = 39600  # ⭐ 11시간 (39600초)\n"
        "#   12시간은 하루(24h)의 약수라 매일 같은 시간대에 알람이 고정됨.\n"
        "#   11시간은 나누어떨어지지 않아 발송 시각이 회차마다 1시간씩 앞당겨져\n"
        "#   '몇 시간마다 스캔한다'는 패턴이 겉으로 드러나지 않음.\n"
        "#   (하루 약 2.18회 스캔 → 기존 대비 스캔 횟수·CPU 사용량은 소폭 증가)",
        1,
    ),
]


def main():
    if not os.path.exists(TARGET):
        print(f"❌ 파일을 찾을 수 없습니다: {TARGET}")
        print("   스크립트를 prz_v7_star_scanner.py 와 같은 폴더에서 실행하세요.")
        sys.exit(1)

    with open(TARGET, "r", encoding="utf-8") as f:
        src = f.read()

    # ----- 1단계: 사전 검사 (하나라도 안 맞으면 아무것도 바꾸지 않음) -----
    print("=" * 60)
    print("🔍 패치 대상 확인 중...")
    print("=" * 60)

    problems = []
    for desc, old, new, expected in RULES:
        found = src.count(old)
        already = src.count(new)

        if found == 0 and already > 0:
            print(f"  ⏭️  {desc} — 이미 적용됨 (건너뜀)")
            continue

        if found == 0:
            problems.append(f"{desc}: 대상 문자열을 찾지 못했습니다.")
            print(f"  ❌ {desc} — 대상 없음")
            continue

        if expected and found != expected:
            problems.append(
                f"{desc}: {expected}곳을 예상했으나 {found}곳 발견 (수동 확인 필요)"
            )
            print(f"  ⚠️  {desc} — {found}곳 발견 (예상 {expected}곳)")
            continue

        print(f"  ✅ {desc} — {found}곳 발견")

    if problems:
        print()
        print("=" * 60)
        print("⛔ 패치를 중단합니다. 아래 항목을 확인하세요:")
        for p in problems:
            print(f"   - {p}")
        print("=" * 60)
        print("파일은 전혀 변경되지 않았습니다.")
        sys.exit(1)

    # ----- 2단계: 백업 -----
    shutil.copy2(TARGET, BACKUP)
    print()
    print(f"💾 백업 완료: {BACKUP}")

    # ----- 3단계: 치환 -----
    out = src
    total = 0
    for desc, old, new, expected in RULES:
        cnt = out.count(old)
        if cnt:
            out = out.replace(old, new)
            total += cnt

    with open(TARGET, "w", encoding="utf-8") as f:
        f.write(out)

    print(f"✏️  총 {total}곳 수정 완료")

    # ----- 4단계: 문법 검사 -----
    print()
    print("=" * 60)
    print("🧪 문법 검사 중...")
    try:
        compile(out, TARGET, "exec")
        print("  ✅ 문법 이상 없음")
    except SyntaxError as e:
        print(f"  ❌ 문법 오류 발생: {e}")
        shutil.copy2(BACKUP, TARGET)
        print("  ↩️  백업에서 자동 복구했습니다. 파일은 원래대로입니다.")
        sys.exit(1)

    print("=" * 60)
    print()
    print("🎉 패치 완료!")
    print()
    print("변경 요약")
    print("-" * 60)
    print("  숏 표기    : 🔴 PRZ 숏(매도) 시그널 → 🎯 PRZ 숏(익절) 추천자리")
    print("  암호화폐   : [코인] → [암호화폐]")
    print("  가격 기준  : 종가 → 캔들 몸통 중간 (시가+종가)/2")
    print("  스캔 주기  : 12시간(43200초) → 11시간(39600초)")
    print("-" * 60)
    print()
    print("⚠️  Always-on Task를 재시작해야 반영됩니다.")


if __name__ == "__main__":
    main()
